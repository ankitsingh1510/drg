{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "APP_ENV": "development" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": { "APP_ENV": "qa" }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "env": { "APP_ENV": "production" }
    }
  }
}
